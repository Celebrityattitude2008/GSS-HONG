modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_FIREBASE_API_KEY = "AIzaSyDpbQhTxtWvQ4CKF90ZuGF8s_KvOiAR9N0"
VITE_FIREBASE_APP_ID = "1:807676046938:web:c8667251a87d24338db263"
VITE_FIREBASE_AUTH_DOMAIN = "gss-hong-db.firebaseapp.com"
VITE_FIREBASE_MESSAGING_SENDER_ID = "807676046938"
VITE_FIREBASE_PROJECT_ID = "gss-hong-db"
VITE_FIREBASE_STORAGE_BUCKET = "gss-hong-db.firebasestorage.app"

[nix]
